# Contact form email delivery (Resend — https://resend.com)
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# Contact form rate limiting (Upstash Redis — https://upstash.com, optional)
# Without these set, the rate limit check is skipped (e.g. in local dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Autonoma Environment Factory (/api/autonoma) — https://docs.autonoma.app
# Two distinct secrets; generate each with `openssl rand -hex 32`.
AUTONOMA_CLIENT_ID=
AUTONOMA_SECRET_ID=
AUTONOMA_SHARED_SECRET=
AUTONOMA_SIGNING_SECRET=

# Writings source (github.com/FoleyDom/synapse) — src/lib/posts.ts fetches
# published posts from `writings/` in this repo at build time.
# Defaults to FoleyDom/synapse on main if unset — only override for a fork
# or a different branch.
SYNAPSE_GITHUB_REPO=
SYNAPSE_GITHUB_BRANCH=
# Only required if the synapse repo is private. A fine-grained PAT with
# read-only "Contents" access to that one repo is enough — set it in Vercel
# project env vars, not just here.
SYNAPSE_GITHUB_TOKEN=
